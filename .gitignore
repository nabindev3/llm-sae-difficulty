# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/

# Virtual envs (the venv lives outside this repo in ../tsfm-sae-routing/venv)
venv/
.venv/

# Local IDE/editor state
.vscode/
.idea/
*.swp

# Local run logs (regeneratable; large; not paper-relevant)
logs/

# Multi-seed / sweep working checkpoints + scores (large, regeneratable).
# The small summary JSONs and run logs alongside them ARE kept.
**/_work*/

# Transcoder MLP-in/out tensors (regeneratable via extract_mlp.py).
activations_mlp/*.safetensors

# Gemma extraction tensors (large, regeneratable; license-gated model).
activations_gemma/*.safetensors

# Large generated artifacts — uncomment if you intend to keep them out of git.
# Keep checked in by default so paper numbers are reproducible from disk.
# activations/*.safetensors
# activations_late/*.safetensors
# activations_allpos/*.safetensors
# sae/checkpoints*/sae_topk_32.pt

# Gemma extraction intermediate chunks (resumable; regeneratable)
activations_gemma/_chunks/

# Extension configs: activations/SAEs/probe jsons (regeneratable; summary kept in eval/results)
activations_ext/

# Layer-sweep activations (large, regeneratable; summary+plot kept)
activations_layersweep/

# Causal coverage/position-matched intermediates (regeneratable; summaries+plots kept)
eval/results/coverage/k*/
eval/results/position_matched/A_*/
eval/results/position_matched/B_*/
eval/results/position_matched/C_*/

# Regeneratable run logs
eval/results/*.log
eval/results/layersweep/run.log
activations_gemma/*.log
activations_mlp/
